month = int(input("Please enter the month number: "))

if month in range(0, 3): 
    quarter = 1 
    print(quarter)
elif month in range(3, 6):
    quarter = 2
    print(quarter)
elif month in range(6, 9): 
    quarter = 3
    print(quarter)
elif month in range(9, 12): 
    quarter = 4
    print(quarter)
else: 
    raise ValueError("Invalid number")
    
